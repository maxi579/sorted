{
  "expo": {
    "name": "Sorted",
    "slug": "sorted",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "sorted",
      "appgastos"
    ],
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.maxi579.sorted"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b1120",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.maxi579.sorted"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1120",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para leer las capturas y fotos de tus tickets y comprobantes.",
          "cameraPermission": "Para sacarle una foto al ticket o la factura y anotarla sola.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Para que solo vos puedas abrir Sorted con Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0b1120",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d1fe309-48d4-43e4-b9c9-c531b8704e9a"
      }
    },
    "owner": "maxi755",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7d1fe309-48d4-43e4-b9c9-c531b8704e9a"
    }
  }
}
